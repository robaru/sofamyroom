# https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8
end_of_line = lf

[*.{c,h}]
indent_style = tab

[*.{yml,yaml,toml}]
indent_size = 2

[*.{bat,m}]
indent_style = tab
end_of_line = crlf

[Makefile]
indent_style = tab
